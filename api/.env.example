# Banco de dados ------------------------------------------------------------
# Tipo do banco: "sqlite" (dev/testes) ou "mysql" (producao).
DATABASE_TYPE=sqlite

# Usado apenas quando DATABASE_TYPE=sqlite. ":memory:" cria um banco em RAM.
DATABASE_FILE=./data/locadora.sqlite

# Usado apenas quando DATABASE_TYPE=mysql.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=locamais

# Cria/atualiza as tabelas no boot. Deixe "false" e use migrations em prod.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Autenticacao ---------------------------------------------------------------
# Gere um valor forte e aleatorio para cada ambiente; nunca versione o valor real.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Custo do bcrypt. 10 e um bom default; 4 acelera muito os testes.
BCRYPT_ROUNDS=10

# Seed do primeiro admin -----------------------------------------------------
# Aplicado apenas quando ainda nao existe nenhum admin. Apague estas linhas
# (ou zere ADMIN_PASSWORD) depois do primeiro boot em producao.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Observabilidade (opcional) -------------------------------------------------
# Crie uma aplicacao em https://observe.nestjs.com e cole a chave e o segredo
# gerados. Sem credenciais validas, o agente nao envia telemetria.
# NUNCA versione os valores reais: use o .env local ou o painel do provedor.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=api

# REDIS -----------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Aplicacao ------------------------------------------------------------------
PORT=3000
# Bind local por padrão; use 0.0.0.0 somente quando celulares precisarem acessar
# a API pela rede local. Isso não altera o bind de MySQL ou Redis.
HOST=127.0.0.1
# HTTPS é opcional. Quando true, ambos os arquivos devem existir e ser válidos;
# caminhos relativos são resolvidos a partir da pasta api/.
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
# Origens web adicionais, separadas por vírgulas. Em branco usa origens locais
# de desenvolvimento e Capacitor declaradas em app.setup.ts.
CORS_ORIGINS=

# Recuperacao de senha / SMTP do Gmail ---------------------------------------
# Configure MAIL_PASSWORD com uma senha de app do Gmail, nunca a senha normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Base pública do frontend, sem rota e sem barra final.
FRONTEND_BASE_URL=http://localhost:8100
