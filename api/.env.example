# Banco de dados ------------------------------------------------------------
# Tipo do banco: "sqlite" (dev/testes) ou "mysql" (producao).
DATABASE_TYPE=sqlite

# Usado apenas quando DATABASE_TYPE=sqlite. ":memory:" cria um banco em RAM.
DATABASE_FILE=./data/locadora.sqlite

# Usado apenas quando DATABASE_TYPE=mysql.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_NAME=locadora

# Cria/atualiza as tabelas no boot. Deixe "false" e use migrations em prod.
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Autenticacao ---------------------------------------------------------------
# Troque por um valor forte e aleatorio. Nao versione o valor real.
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=1h

# Custo do bcrypt. 10 e um bom default; 4 acelera muito os testes.
BCRYPT_ROUNDS=10

# Seed do primeiro admin -----------------------------------------------------
# Aplicado apenas quando ainda nao existe nenhum admin. Apague estas linhas
# (ou zere ADMIN_PASSWORD) depois do primeiro boot em producao.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@locamais.com
ADMIN_PASSWORD=TrocarEstaSenha1!

# Aplicacao ------------------------------------------------------------------
PORT=3000